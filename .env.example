# Copy to .env and fill in. Never commit .env.
# Session-mode Postgres connection string of your Supabase project (port 5432)
SUPABASE_DB_DSN=postgresql://USER.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Which target profile in pipeline/target.py to use
PIPELINE_TARGET=ml_test
# Paths are set in pipeline/run_ml_test.py: NAS_ROOT (the media share) and BATCH_DIR (local batch lists)
